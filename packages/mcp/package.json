{
  "name": "@rmpsoftware/locus-mcp",
  "version": "0.1.5",
  "mcpName": "io.github.rmpsoftware/locus-mcp",
  "description": "Locus MCP server — agent-first LSP code intelligence for Cursor, Claude Code, and AI agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "locus": "dist/locus.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmpsoftware/locus-mcp.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/rmpsoftware/locus-mcp/issues"
  },
  "homepage": "https://github.com/rmpsoftware/locus-mcp/tree/main/packages/mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lsp",
    "language-server-protocol",
    "ai-agent",
    "code-intelligence",
    "cursor",
    "claude-code",
    "vscode",
    "typescript",
    "semantic-navigation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build --workspace @rmpsoftware/locus-core && npm run build",
    "build": "tsc -p tsconfig.json && npm run bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "bundle": "rolldown --config rolldown.config.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@rmpsoftware/locus-core": "0.1.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "rolldown": "^1.2.16",
    "tsx": "^4.19.2"
  }
}
