{
  "root": ".",
  "servers": [
    {
      "id": "typescript",
      "warm": true,
      "languageId": "typescript",
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mts",
        ".cts",
        ".mjs",
        ".cjs"
      ],
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ]
    }
  ]
}